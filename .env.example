# The CLI does not automatically load this file.
# Local: copy to .env, then node --env-file=.env dist/cli.js
INSPECTOR_MODE=local
INSPECTOR_PORT=8795
INSPECTOR_DEMO_PORT=8796
# INSPECTOR_DATA_DIR=/absolute/private/inspector-data

# Hosted direct Node deployment (set MODE=hosted):
# INSPECTOR_HOST=127.0.0.1
# INSPECTOR_PUBLIC_URL=https://inspector.example.com
# INSPECTOR_OIDC_ISSUER=https://identity.example.com/your-issuer
# INSPECTOR_OIDC_CLIENT_ID=your-client-id
# INSPECTOR_OIDC_CLIENT_SECRET_FILE=/absolute/private/oidc-secret.txt
# INSPECTOR_WORKER_URL=https://private-worker.example.com
# INSPECTOR_WORKER_TOKEN_FILE=/absolute/private/worker-token.txt
# INSPECTOR_OIDC_REQUIRED_ACR=provider-specific-mfa-context

# Docker Compose reads .env automatically and forces hosted mode.
# Set DOMAIN, ISSUER and CLIENT_ID above; put the client secret in
# secrets/oidc_client_secret.txt. Do not commit that file.
# INSPECTOR_DOMAIN=inspector.example.com

# Compose also needs secrets/worker_token.txt (32+ cryptographically random characters).
# Worker process only: INSPECTOR_WORKER_HOST=0.0.0.0, INSPECTOR_WORKER_PORT=8799
